# Discord bot token（Developer Portal 取得，勿提交真實值）
DISCORD_BOT_TOKEN=
# 只在此 Discord 伺服器註冊指令
DISCORD_GUILD_ID=
# backend 位址，預設同機
BACKEND_BASE_URL=http://localhost:8000
# 選用：啟用僅限 loopback 的 operator result-delivery API；兩者必須一起設定
DISCORD_OPERATOR_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
DISCORD_DESTINATION_ALIASES={"results":"YOUR_DISCORD_CHANNEL_ID"}
DISCORD_OPERATOR_PORT=8765
# Required absolute, explicitly provisioned bound history. Never replace legacy history.
DISCORD_DELIVERY_LEDGER_PATH=/absolute/private/result-deliveries.json
# Optional closed startup: no Discord login/sync; authenticated loopback management only.
AI_DRAWING_MAINTENANCE=closed
